# MOEGI 環境変数サンプル。
#
# .env は作成しない・読まない方針（ユーザーのセキュリティ規約）。
# 接続情報はアプリ層で解決する：環境変数 > macOSキーチェーン の優先順。

# ORCA ROUTER 接続情報。
# APIキーは macOS のキーチェーン（service 名 `orca-api`）に保存できる。
# ORCA_API_KEY 未設定時は llm.py がキーチェーンへフォールバックする。
# キーを登録し直す場合は対話式で実行（履歴にキーを残さないため）:
#   security add-generic-password -a "$USER" -s orca-api -w
ORCA_BASE_URL=https://api.orcarouter.ai/v1
ORCA_API_KEY=

# ローカルLLM（Ollama）。OpenAI互換エンドポイント。既定値のままで動く。
OLLAMA_BASE_URL=http://localhost:11434

# --- 以下はすべて任意。説明は README の「環境変数」の表を参照 ---
# MOEGI_PRIVACY_MODE=enforce
# MOEGI_PORT=8420
# MOEGI_LAN=1                       # 1 にすると同一ネットワークへ公開（下のパスワードが必須）
# MOEGI_ACCESS_TOKEN=               # 全画面のパスワード。ここには書かず、起動時に export する
# MOEGI_SITE_NAME=                  # FAX様式の宛名に使う事業所名
# MOEGI_DELIVERY_TO=kanri@example.local
# MOEGI_SMTP_HOST=                  # 未設定なら data/outbox/ へのファイル書き出し（実際には送られない）
# MOEGI_SMTP_PORT=587
# MOEGI_SMTP_USER=
# MOEGI_SMTP_PASSWORD=              # ここには書かず、起動時に export する
# MOEGI_SMTP_FROM=moegi@example.local
# MOEGI_DELIVERY_PROBE=1.1.1.1:53
# MOEGI_VAULT_KEY=                  # 仮名対応表の暗号鍵（base64url・32バイト）。データと別の場所で管理する
